# --- PostgreSQL ---
# Admin/owner connection used by load_data.py
DATABASE_URL=postgresql://siat:siat@localhost:5432/siat
# Read-only connection for the agent (role siat_reader is created by schema.sql; change its password!)
AGENT_DATABASE_URL=postgresql://siat_reader:change_me@localhost:5432/siat

# --- ИИ (LLM) ---
# Без ключа агент работает в режиме правил (словарь синонимов).
# openai = тот же ключ, что у Qonunchi (https://platform.openai.com/api-keys); openrouter = альтернатива
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Если когда-нибудь перейдёшь на OpenRouter:
# AI_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4.1-mini

# --- SIAT ---
SIAT_API=https://siat.stat.uz/api
# SIAT_DATA_DIR=./data
LOG_LEVEL=INFO

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_USERS=12345,67890   # пусто = все
TELEGRAM_LIMIT_PER_HOUR=30
